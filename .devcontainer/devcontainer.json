{
  "name": "study studio · 私有预览",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-24-bookworm",
  "forwardPorts": [
    3000
  ],
  "portsAttributes": {
    "3000": {
      "label": "study studio",
      "onAutoForward": "openBrowser",
      "protocol": "http"
    }
  },
  "postAttachCommand": "node .devcontainer/start-preview.mjs",
  "postCreateCommand": "npm ci"
}
